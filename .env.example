# SMESH Dashboard environment template.
#
# 1. Copy this file to `.env` in the same directory:
#       cp .env.example .env        # macOS/Linux
#       Copy-Item .env.example .env # PowerShell
# 2. Fill in the REQUIRED values below.
# 3. Run `docker compose up --build -d`.
#
# `.env` is gitignored
# ============================================================
# InfluxDB connection (REQUIRED)
# ============================================================

# URL of your InfluxDB 2.x instance. Must be reachable from inside the
# Docker containers, so use a LAN IP or `host.docker.internal` (Docker
# Desktop). Do NOT use `localhost` / `127.0.0.1` — that points at the
# container, not your host.
INFLUXDB_URL=http://your-influxdb-host:8086

# API token with READ access to the bucket below. Admin tokens work; a
# read-only token scoped to one bucket is safer.
INFLUXDB_TOKEN=replace-with-your-influxdb-token

# Organization name as it appears in InfluxDB.
INFLUXDB_ORG=your-org

# Bucket containing your telemetry data.
INFLUXDB_BUCKET=your-bucket

# ============================================================
# InfluxDB schema (optional — defaults match the Meshtastic exporter)
# ============================================================

# Measurement name to filter on (the `_measurement` column).
INFLUX_MEASUREMENT=environment

# Tag column that identifies each node. `fromNode` for the Meshtastic
# exporter; older deployments used `node` or `node_id`.
INFLUX_NODE_TAG=fromNode

# ============================================================
# Grafana admin login (REQUIRED — change before exposing publicly)
# ============================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
